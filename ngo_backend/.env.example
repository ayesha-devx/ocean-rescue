# ==============================================================================
# OceanRescue NGO Conservation Operations Platform — Backend Environment Config
# Copy this file to .env and configure local environment settings.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Application Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Database Connection (PostgreSQL 18 + PostGIS 3.6.2)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/oceanrescue

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (Comma-separated list of permitted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Settings
UPLOAD_DIR=uploads/reports
MAX_UPLOAD_SIZE_BYTES=20971520

# Optional Security / JWT settings for future authenticated phases
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
